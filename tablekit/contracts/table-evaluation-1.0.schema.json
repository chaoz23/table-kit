{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaoz23/table-kit/contracts/table-evaluation-1.0.schema.json",
  "title": "Table EvaluationResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "tool", "subject", "status",
    "exit_code", "authority_status", "coverage", "cursor", "context",
    "findings", "advisories", "warnings", "errors"
  ],
  "properties": {
    "schema_version": {"const": "table.evaluation/1.0"},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["session", "character", "rules_query", "artifact"]},
        "id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/nullableId"},
        "entity_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "status": {
      "enum": ["checked_clean", "checked_with_advisories", "findings", "incomplete", "unsupported", "invalid", "internal_error"]
    },
    "exit_code": {"enum": [0, 1, 2]},
    "authority_status": {"enum": ["self_attested", "host_attested"]},
    "coverage": {"$ref": "#/$defs/coverage"},
    "cursor": {
      "type": "object", "additionalProperties": false,
      "required": ["checked_through_event_id", "gap_state", "input_digest"],
      "properties": {
        "checked_through_event_id": {"$ref": "#/$defs/nullableId"},
        "gap_state": {"enum": ["none", "detected", "unknown"]},
        "input_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["roster_digest", "policy_digest", "config_digest", "source_set_digest"],
      "properties": {
        "roster_digest": {"$ref": "#/$defs/nullableDigest"},
        "policy_digest": {"$ref": "#/$defs/nullableDigest"},
        "config_digest": {"$ref": "#/$defs/nullableDigest"},
        "source_set_digest": {"$ref": "#/$defs/nullableDigest"},
        "session_descriptor_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "advisories": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "checked_clean"}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"const": 0},
          "coverage": {"properties": {"complete": {"const": true}, "compatible": {"minimum": 1}, "skipped": {"const": 0}}},
          "cursor": {"properties": {"gap_state": {"const": "none"}}},
          "findings": {"maxItems": 0}, "advisories": {"maxItems": 0}, "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "checked_with_advisories"}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"const": 1},
          "coverage": {"properties": {"complete": {"const": true}, "compatible": {"minimum": 1}, "skipped": {"const": 0}}},
          "cursor": {"properties": {"gap_state": {"const": "none"}}},
          "findings": {"maxItems": 0}, "advisories": {"minItems": 1}, "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "findings"}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"const": 1},
          "coverage": {"properties": {"complete": {"const": true}, "compatible": {"minimum": 1}, "skipped": {"const": 0}}},
          "cursor": {"properties": {"gap_state": {"const": "none"}}},
          "findings": {"minItems": 1}, "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["incomplete", "unsupported", "invalid", "internal_error"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "exit_code": {"const": 2},
          "coverage": {"properties": {"complete": {"const": false}}},
          "errors": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"authority_status": {"const": "host_attested"}}, "required": ["authority_status"]},
      "then": {
        "properties": {
          "context": {
            "required": ["session_descriptor_digest"],
            "properties": {"session_descriptor_digest": {"$ref": "#/$defs/digest"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["checked_clean", "checked_with_advisories", "findings"]},
          "coverage": {"properties": {"evidence_required": {"const": true}}}
        },
        "required": ["status", "coverage"]
      },
      "then": {"properties": {"coverage": {"properties": {"eligible": {"minimum": 1}, "evaluated": {"minimum": 1}}}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "nullableId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "evidence_required", "input", "compatible", "eligible", "evaluated", "skipped", "evaluators"],
      "properties": {
        "complete": {"type": "boolean"},
        "evidence_required": {"type": "boolean"},
        "input": {"type": "integer", "minimum": 0},
        "compatible": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0},
        "evaluated": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "evaluators": {"type": "array", "items": {"$ref": "#/$defs/evaluatorCoverage"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "evaluated"}}, "required": ["status"]},
          "then": {"properties": {"evaluated": {"minimum": 1}, "skipped": {"const": 0}, "skip_reasons": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_applicable"}}, "required": ["status"]},
          "then": {"properties": {"eligible": {"const": 0}, "evaluated": {"const": 0}, "skipped": {"const": 0}, "skip_reasons": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["skipped", "disabled", "error"]}}, "required": ["status"]},
          "then": {"properties": {"skip_reasons": {"minItems": 1}}}
        }
      ]
    },
    "evaluatorCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "required", "status", "eligible", "evaluated", "skipped", "skip_reasons"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "required": {"type": "boolean"},
        "status": {"enum": ["evaluated", "not_applicable", "skipped", "disabled", "error"]},
        "eligible": {"type": "integer", "minimum": 0},
        "evaluated": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "skip_reasons": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "code", "severity", "summary", "evidence_refs", "effective_policy", "policy_version", "policy_digest"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "code": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["finding", "advisory"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "effective_policy": {"type": "object"},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "message": {"type": "string", "minLength": 1},
        "pointer": {"type": "string"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
